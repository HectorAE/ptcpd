cabal-version:  3.14

-- SPDX-FileCopyrightText: 2016, 2025 Hector A. Escobedo <hae@dry.email>
-- SPDX-License-Identifier: GPL-3.0-only

name:           ptcpd
version:        0.3.1
stability:      experimental
synopsis:       Plain Text Chat Protocol daemon
description:    Group communication without overhead
homepage:       https://github.com/HectorAE/ptcpd
license:        GPL-3.0-only
license-files:  LICENSES/GPL-3.0-only.txt
author:         Hector A. Escobedo
maintainer:     hae@dry.email
copyright:      2016, 2025 Hector A. Escobedo
category:       Network
build-type:     Simple
extra-files:
    README.md
tested-with:
    GHC ==
      { 9.12.2
      , 9.10.1
      , 9.8.4
      , 9.6.6
      , 9.4.8
      }

source-repository head
    type: git
    location: https://github.com/HectorAE/ptcpd

executable ptcpd
    hs-source-dirs: src
    main-is: Main.hs
    build-depends:
        base >= 4.9 && < 4.22
      , bytestring >= 0.10 && < 0.13
      , containers >= 0.5 && < 0.9
      , network >= 3.1 && < 3.3
      , stm >= 2.4 && < 2.6
    default-language: Haskell2010
    ghc-options: -Wall -Wcompat
